{
  "name": "smart-bartender-app",
  "version": "3.0.1",
  "private": true,
  "type": "module",
  "description": "AI 스마트 바텐더 v3.0 — 웹앱(PWA) 하나로 PC·안드로이드 (Vite + React)",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && node scripts/check-no-secrets.mjs",
    "preview": "vite preview",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "icons": "node scripts/gen-icons.mjs",
    "build:android": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android.ps1",
    "build:exe": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-exe.ps1",
    "cap:sync": "cap sync android",
    "electron:dev": "node scripts/electron-dev.mjs",
    "keystore": "node scripts/make-keystore.mjs",
    "check:secrets": "node scripts/check-no-secrets.mjs"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "8.3.0",
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/preferences": "8.0.1",
    "lucide-react": "^1.70.0",
    "pretendard": "^1.3.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5",
    "workbox-window": "^7.4.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-bluetooth": "^0.0.22",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0"
  }
}
